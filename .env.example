# ===========================================================================
# SatQuery AI - environment configuration
#
# EVERY VALUE HERE IS OPTIONAL. The system runs fully with no .env file at
# all: NASA GIBS needs no credentials, the rule-based parser needs no model,
# and the deterministic narrator needs no API key. Copy this to `.env` only
# when you want to change a default.
# ===========================================================================

# --- Optional: LLM layer ---------------------------------------------------
# When set, Claude is used for TWO things only:
#   1. parsing the question into a typed plan (via strict tool calling), and
#   2. phrasing the final narration.
# It never produces a measurement, and every numeral it writes is verified
# against the fact store before display. Without a key the rule parser and the
# template narrator take over and the pipeline is otherwise identical.
# ANTHROPIC_API_KEY=sk-ant-...
# SATQUERY_LLM_MODEL=claude-sonnet-4-5
# SATQUERY_LLM_ENABLED=true
# SATQUERY_LLM_TIMEOUT=30

# --- Grounding -------------------------------------------------------------
# strict: any narrated number that cannot be traced to a measured fact causes
# the whole narration to be replaced by the deterministic template.
SATQUERY_STRICT_GROUNDING=true
# Relative tolerance when matching a narrated number to a fact.
SATQUERY_NUMERIC_TOLERANCE=0.02

# --- Data retrieval --------------------------------------------------------
# Side of the square analysis grid, in pixels. 512 is the demo default;
# 256 is noticeably faster, 1024 is sharper and slower.
SATQUERY_RASTER_SIZE=512
SATQUERY_HTTP_TIMEOUT=45
SATQUERY_HTTP_RETRIES=2
SATQUERY_MAX_PARALLEL_FETCH=8

# Serve only from the on-disk cache and never touch the network. Useful if the
# venue Wi-Fi fails: previously answered queries still work, and anything not
# cached reports "no data" rather than inventing a result.
SATQUERY_OFFLINE=false
SATQUERY_CACHE=true
SATQUERY_CACHE_TTL=1209600

# --- Server ----------------------------------------------------------------
SATQUERY_HOST=127.0.0.1
SATQUERY_PORT=8000
SATQUERY_CORS=http://localhost:5173,http://127.0.0.1:5173
SATQUERY_MAX_UPLOAD_MB=60

# --- Paths -----------------------------------------------------------------
# SATQUERY_DATA_DIR=/absolute/path/to/data

# --- Endpoints (override only to mirror or proxy NASA) ---------------------
# GIBS_WMS_URL=https://gibs.earthdata.nasa.gov/wms/epsg4326/best/wms.cgi
